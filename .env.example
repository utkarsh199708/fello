# Copy to .env for local runs. .env is gitignored. Never commit real values.
# Every value below is a dev-only placeholder. In production these are Railway service variables.

# Host port for the Compose db service. If another program holds 5432, pick a free port here
# and use the same port in DATABASE_URL and TEST_DATABASE_URL below.
DB_PORT=5432

# Postgres admin (superuser) URL. `python -m app migrate` uses it to create the database and the
# three roles. Every other connection uses a role URL derived from it (app/db.py).
# Use 127.0.0.1, not localhost. On Windows, localhost tries ::1 first, and psycopg
# waits out the whole connect timeout there (measured: 60 to 130 s) before trying IPv4.
# Inside Compose, web and worker override it to point at the db service.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/app

# Role passwords. app_owner runs migrations, app_batch (BYPASSRLS) runs training only,
# app runs web, worker and loader. Roles are cluster-wide, so every local database shares them.
APP_OWNER_PASSWORD=app_owner_dev
APP_BATCH_PASSWORD=app_batch_dev
APP_PASSWORD=app_dev

# Nightly job schedule: a five-field cron expression, evaluated in UTC. Default 02:00.
NIGHTLY_CRON="0 2 * * *"

# Fixed "now" for the job and the dashboard (ISO 8601, UTC), for demos and backtests.
# Empty means no override.
CLOCK_OVERRIDE=

# First-start bootstrap: the generator config, and where generated data is written.
BOOTSTRAP_CONFIG=config/full.yaml
DATA_DIR=data

# Web. SESSION_SECRET signs the session cookie. BASIC_AUTH_PASSWORD is the one shared password.
# COOKIE_SECURE=1 marks the cookie HTTPS-only; keep 0 for plain-HTTP local runs.
SESSION_SECRET=dev-only-session-secret
BASIC_AUTH_PASSWORD=dev-only-password
COOKIE_SECURE=0
PORT=8000

# Tests only. The test session drops and recreates this database, so its name must start with
# fello_test. Point it at your own database, for example .../fello_test_<name>.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/fello_test

# Optional LLM narration of the reason list. Off while the key is empty.
LLM_API_KEY=
LLM_MAX_CALLS_PER_RUN=50
